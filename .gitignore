.env
.env.*
!.env.example
server/oauth-allowlist.txt

# OS / editor
.DS_Store
*.swp
*~

# Generated persona sprites (reproducible via seeds in docs/specs/personas.md)
/assets-work/

agent.*.json

# Local dev scratch (scripts/dev.sh writes server/dashboard/runner logs here)
/tmp/

# Per-agent implementation worktrees (docs/specs/agent-operations.md)
/worktrees/
