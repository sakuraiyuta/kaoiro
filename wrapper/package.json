{
  "name": "@kaoiro/wrapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "kaoiro ラッパー — Claude Agent SDK をホストし状態を導出する",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "for f in agent.*.json; do node dist/cli.js \"$f\" & done; wait",
    "dev": "for f in agent.*.json; do [ -e \"$f\" ] || continue; tsx watch src/cli.ts \"$f\" & done; wait"
  },
  "devDependencies": {
    "@kaoiro/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/phoenix": "^1.6.7",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "fflate": "^0.8.3",
    "officeparser": "^7.2.2",
    "pdf-lib": "^1.17.1",
    "phoenix": "^1.8.7",
    "sharp": "^0.35.2"
  }
}
