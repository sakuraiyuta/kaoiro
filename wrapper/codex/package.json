{
  "name": "@kaoiro/codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "kaoiro Codex アダプタ — @openai/codex-sdk をホストし状態を導出する (ADR-0032)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "kaoiro": {
    "runtimeAssets": [
      "dist/bridge.js",
      "dist/build-info.json"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/generate-wrapper-build-info.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kaoiro/agent-common": "workspace:*",
    "@kaoiro/wrapper-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "0.153.4",
    "@openai/codex-sdk": "^0.153.4"
  },
  "devDependencies": {
    "@kaoiro/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
