# Required for the prod release. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname (URL generation / WebSocket origin check).
# Local verification: localhost. Deployment: the vhost name.
PHX_HOST=localhost

# HTTP listen port (default 4000; keep in sync with the compose ports
# mapping).
# PORT=4000

# Socket auth (ADR-0011 / issue #28). Unset behaviour differs by socket:
#   KAOIRO_CLIENT_TOKENS unset -> client connections are REJECTED
#     (fail-closed): the dashboard needs a token even for local use, so a
#     misconfigured deploy is locked rather than wide-open as operator.
#   KAOIRO_WRAPPER_TOKENS unset -> wrapper auth disabled (dev mode); keep
#     the endpoint loopback-only (the compose default).
#   KAOIRO_RUNNER_TOKENS unset -> runner auth disabled (dev mode), same
#     shape as wrapper (ADR-0023).
# Always set ALL THREE for any network-reachable deployment.
# KAOIRO_WRAPPER_TOKENS=lab-pc-1.ao:wrapper-token,...
# KAOIRO_RUNNER_TOKENS=lab-pc-1:runner-token,...
# KAOIRO_CLIENT_TOKENS=client-token:operator,viewer-token:viewer

# Sprite overlay dir inside the container (pair with the compose volume).
# KAOIRO_PERSONA_DIR=/personas
