# kaoiro runner service environment — copy to the user config dir as
# `runner.env` and `chmod 600` it (Linux: ${XDG_CONFIG_HOME:-~/.config}/kaoiro,
# macOS: ~/Library/Application Support/kaoiro).
#
# kaoiro-runner-launch.sh sources this at service start, so the token never
# has to be written into the systemd unit or the launchd plist. Keep the
# filled-in copy out of git.
#
# Format: plain KEY=VALUE, one per line (sourced by /bin/sh — no spaces around
# `=`, quote values containing spaces).

# Server-side runner auth token. The server expects
# KAOIRO_RUNNER_TOKENS=<host_id>:<token>; put only the <token> half here.
# Unset = the server's runner auth is disabled (dev only; in prod the server
# rejects the connection fail-closed, issue #133).
KAOIRO_RUNNER_TOKEN=

# Pin the Node binary when a version manager (nvm / fnm / asdf) owns it:
# systemd user units and launchd agents start with a minimal PATH.
#KAOIRO_NODE=/home/you/.nvm/versions/node/v22.20.0/bin/node

# Make version-managed commands available to agent tool shells. Keep the
# directory containing `asdf` and standard system directories: shims invoke
# `asdf` by name, so adding only the shims directory is insufficient.
#PATH="$HOME/.asdf/shims:$HOME/.asdf/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Codex state directory (auth, sessions, state databases) for every Codex
# wrapper this runner starts and for the runner's own session scan. Use the
# absolute path of an existing directory; unset or empty keeps the Codex
# default, ~/.codex. A relative or missing path makes the runner refuse Codex
# launches (other engines keep running). Do not export it from a shell profile:
# the global `codex` CLI would then share the directory. Read once at start, so
# restart the runner after changing it. See docs/operations/codex-home.md.
#CODEX_HOME=/home/you/.local/share/kaoiro/codex-home

# Override the runner config path (default: <config dir>/runner.config.json).
#KAOIRO_RUNNER_CONFIG=/etc/kaoiro/runner.config.json

# DEPRECATED: set `server_url` in runner.config.json instead (issue #469). The
# variable still overrides the file — the runner warns once per process, and
# warns again when the JSON value changes while this hides it. Must be ws:// or
# wss://; a malformed value fails fast at startup AND on config reload. Remove
# it from this file once `server_url` is in the JSON.
#KAOIRO_RUNNER_SERVER_URL=wss://kaoiro.example.com/runner

# DEPRECATED: set `"log_phoenix_heartbeats": true` in runner.config.json instead
# (it applies live, with no restart). The variable still overrides the file:
# exactly 1 keeps Phoenix's periodic heartbeat push/reply lines, any other set
# value omits them. They are omitted by default so runner.log keeps transport
# errors and control messages visible.
#KAOIRO_RUNNER_LOG_PHOENIX_HEARTBEATS=1
