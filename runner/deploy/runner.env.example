# kaoiro runner service environment — copy to the user config dir as
# `runner.env` and `chmod 600` it (Linux: ${XDG_CONFIG_HOME:-~/.config}/kaoiro,
# macOS: ~/Library/Application Support/kaoiro).
#
# kaoiro-runner-launch.sh sources this at service start, so the token never
# has to be written into the systemd unit or the launchd plist. Keep the
# filled-in copy out of git.
#
# Format: plain KEY=VALUE, one per line (sourced by /bin/sh — no spaces around
# `=`, quote values containing spaces).

# Server-side runner auth token. The server expects
# KAOIRO_RUNNER_TOKENS=<host_id>:<token>; put only the <token> half here.
# Unset = the server's runner auth is disabled (dev only; in prod the server
# rejects the connection fail-closed, issue #138).
KAOIRO_RUNNER_TOKEN=

# Pin the Node binary when a version manager (nvm / fnm / asdf) owns it:
# systemd user units and launchd agents start with a minimal PATH.
#KAOIRO_NODE=/home/you/.nvm/versions/node/v22.20.0/bin/node

# Override the runner config path (default: <config dir>/runner.config.json).
#KAOIRO_RUNNER_CONFIG=/etc/kaoiro/runner.config.json

# server_url currently comes from runner.config.json. Once issue #140 lands an
# env override, set it here instead of editing the JSON.
